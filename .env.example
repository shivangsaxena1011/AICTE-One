# ==============================================================================
# AICTE ONE - Platform Configuration Environment Variables
# ==============================================================================

# Database Configuration (Defaults to local SQLite if unspecified)
DATABASE_URL=sqlite:///./aicte_governance.db
# For PostgreSQL Production:
# DATABASE_URL=postgresql://aicte_admin:SecurePass123!@localhost:5432/aicte_one

# Host and Port Configuration
HOST=0.0.0.0
PORT=8000

# Google Gemini API Key for Evidence-Grounded AI Governance Copilot
# If unset, Copilot falls back to deterministic regulatory knowledge base
GEMINI_API_KEY=

# Security & CORS
SECRET_KEY=aicte-one-super-secret-governance-key-2024
CORS_ORIGINS=*

# Environment Designation
ENVIRONMENT=Demonstration / Sandbox
REGULATORY_FRAMEWORK=AICTE Approval Process Handbook (APH) 2024-2027
